{
  "name": "julies-kokebok",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:auth": "npx -y firebase-tools@latest emulators:exec --only auth --project demo-julies-kokebok 'node --test tests/email-auth-emulator.test.mjs'",
    "test:ocr": "node scripts/prepare-ocr.mjs && node tests/ocr.mjs",
    "build": "npm run check && node scripts/prepare-ocr.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/nor": "1.0.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "7.0.0",
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
